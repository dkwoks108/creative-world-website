datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("ADMIN")
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id                String    @id @default(uuid())
  userId            String
  user              AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  token             String    @unique
  expiresAt         DateTime
  lastActivityAt    DateTime  @default(now())
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  userAgent         String?
  ipHash            String?
  createdAt         DateTime  @default(now())
}

model Author {
  id        String   @id @default(uuid())
  name      String
  role      String
  bio       String?
  avatarUrl String?
  createdAt DateTime @default(now())
  posts     Post[]
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  posts       Post[]
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  posts     PostTag[]
}

model Post {
  id                String         @id @default(uuid())
  title             String
  slug              String         @unique
  excerpt           String?
  content           String         // Structured JSON or HTML string
  authorId          String?
  author            Author?        @relation(fields: [authorId], references: [id])
  categoryId        String?
  category          Category?      @relation(fields: [categoryId], references: [id])
  featuredImage     String?
  featuredImageAlt  String?
  imageCaption      String?
  status            String         @default("DRAFT") // DRAFT, REVIEW, SCHEDULED, PUBLISHED, ARCHIVED
  visibility        String         @default("Public") // Public, Private, Password
  featured          Boolean        @default(false)
  publishAt         DateTime?
  scheduledAt       DateTime?
  seoTitle          String?
  metaDescription   String?
  canonicalUrl      String?
  ogTitle           String?
  ogDescription     String?
  ogImage           String?
  noIndex           Boolean        @default(false)
  noFollow          Boolean        @default(false)
  primaryKeyword    String?
  secondaryKeywords String?
  faqsJson          String?
  lastEditor        String?
  views             Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  tags              PostTag[]
  revisions         PostRevision[]

  @@index([slug])
  @@index([status])
  @@index([publishAt])
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model PostRevision {
  id              String   @id @default(uuid())
  postId          String
  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  title           String
  content         String
  seoTitle        String?
  metaDescription String?
  createdBy       String
  createdAt       DateTime @default(now())
}

model Page {
  id              String         @id @default(uuid())
  title           String
  slug            String         @unique
  content         String         // Structured JSON or HTML string
  excerpt         String?
  template        String         @default("default") // default, full-width, landing
  status          String         @default("PUBLISHED") // DRAFT, PUBLISHED
  seoTitle        String?
  metaDescription String?
  ogImage         String?
  publishedAt     DateTime?      @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  revisions       PageRevision[]

  @@index([slug])
}

model PageRevision {
  id        String   @id @default(uuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdBy String
  createdAt DateTime @default(now())
}

model Media {
  id        String   @id @default(uuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  altText   String?
  caption   String?
  createdAt DateTime @default(now())
}

model Inquiry {
  id            String            @id @default(uuid())
  name          String
  email         String
  phone         String?
  businessName  String?
  companyName   String?
  websiteUrl    String?
  goal          String?
  budget        String?
  budgetRange   String?
  businessSize  String?
  timeline      String?
  priority      String?           @default("Medium") // High, Medium, Low
  assignedTo    String?
  lastContacted DateTime?
  nextFollowup  DateTime?
  leadScore     Int?              @default(0)
  message       String
  status        String            @default("New") // New, Contacted, Qualified, Proposal Sent, Won, Lost, Spam
  source        String            @default("Website Form")
  service       String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  referrer      String?
  ipAddress     String?
  device        String?
  landingPage   String?
  notes         InquiryNote[]
  events        InquiryEvent[]
  followups     InquiryFollowup[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

model InquiryNote {
  id        String   @id @default(uuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  content   String
  createdBy String
  createdAt DateTime @default(now())
}

model InquiryEvent {
  id          String   @id @default(uuid())
  inquiryId   String
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  eventType   String   // CREATED, CONTACTED, QUALIFIED, PROPOSAL_SENT, WON, LOST, NOTE_ADDED
  description String
  createdBy   String   @default("System")
  createdAt   DateTime @default(now())
}

model InquiryFollowup {
  id        String   @id @default(uuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  dueDate   DateTime
  status    String   @default("Pending") // Pending, Completed, Missed
  notes     String?
  createdBy String   @default("Admin")
  createdAt DateTime @default(now())
}

model Contact {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phone       String?
  companyName String?
  role        String?
  type        String   @default("Lead") // Lead, Client, Prospect, Partner
  tags        String?  // JSON array string or comma separated
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  domain    String?
  industry  String?
  size      String?
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  content     String?
  status      String   @default("Published") // Published, Draft
  icon        String?
  features    String?  // JSON array string
  process     String?  // JSON array string
  benefits    String?  // JSON array string
  faqs        String?  // JSON array string
  sortOrder   Int      @default(0)
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PricingPlan {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  price         String
  billingPeriod String   @default("/month")
  description   String?
  features      String?  // JSON array string
  isPopular     Boolean  @default(false)
  status        String   @default("Published")
  sortOrder     Int      @default(0)
  ctaText       String   @default("Get Started")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CaseStudy {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  client       String?
  industry     String?
  summary      String?
  content      String?
  challenge    String?
  solution     String?
  results      String?  // JSON or text
  image        String?
  technologies String?  // JSON array string
  status       String   @default("Published")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TeamMember {
  id           String   @id @default(uuid())
  name         String
  designation  String
  department   String?
  photoUrl     String?
  bio          String?
  email        String?
  phone        String?
  linkedinUrl  String?
  instagramUrl String?
  twitterUrl   String?
  sortOrder    Int      @default(0)
  status       String   @default("Active") // Active, Inactive
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Testimonial {
  id              String   @id @default(uuid())
  clientName      String
  company         String?
  designation     String?
  photoUrl        String?
  rating          Int      @default(5)
  quote           String
  serviceCategory String?
  status          String   @default("Approved") // Pending, Approved, Draft
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NavigationMenu {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  location  String     @default("header") // header, footer, mobile
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id         String          @id @default(uuid())
  menuId     String
  menu       NavigationMenu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  label      String
  href       String
  target     String          @default("_self")
  icon       String?
  sortOrder  Int             @default(0)
  parentId   String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Form {
  id             String           @id @default(uuid())
  name           String
  slug           String           @unique
  fieldsJson     String           // JSON string of fields
  autoReplyEmail Boolean          @default(true)
  status         String           @default("Active")
  submissions    FormSubmission[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model FormSubmission {
  id        String   @id @default(uuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  dataJson  String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  status    String   @default("Subscribed")
  source    String   @default("Footer")
  createdAt DateTime @default(now())
}

model BlogComment {
  id        String   @id @default(uuid())
  postId    String
  name      String
  email     String
  content   String
  status    String   @default("Pending") // Pending, Approved, Rejected, Spam
  createdAt DateTime @default(now())
}

model ChatbotLead {
  id           String   @id @default(uuid())
  name         String?
  email        String?
  phone        String?
  conversation String?  // JSON or text transcript
  status       String   @default("New")
  createdAt    DateTime @default(now())
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Redirect {
  id         String   @id @default(uuid())
  sourcePath String   @unique
  targetPath String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userName   String?
  action     String
  resource   String
  resourceId String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}
